{
  "name": "z1-providers",
  "version": "0.1.0",
  "private": true,
  "description": "One z1 node per models.dev provider, plus the catalog they read and a config installer.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "generate": "node scripts/generate.ts --from-url https://models.dev/api.json",
    "health": "node scripts/generate.ts --check",
    "install-providers": "node scripts/install-providers.ts",
    "test": "node --test \"tests/*.test.ts\""
  },
  "files": ["index.js", "lib/", "data/", "manifest.json", "README.md", "LICENSE", "NOTICE"]
}
